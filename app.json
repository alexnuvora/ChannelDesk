{
  "expo": {
    "name": "WhatBuy",
    "slug": "whatbuy",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "co.whatbuy.app",
      "versionCode": 1
    },
    "ios": {
      "bundleIdentifier": "co.whatbuy.app",
      "buildNumber": "1"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "WhatBuy uses your photos to create marketplace listings.",
          "cameraPermission": "WhatBuy uses your camera to photograph items you want to sell."
        }
      ]
    ]
  }
}