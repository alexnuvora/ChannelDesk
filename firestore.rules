rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isParticipant(data) { return signedIn() && request.auth.uid in data.participantIds; }

    match /listings/{listingId} {
      allow read: if resource.data.status == 'active' || (signedIn() && resource.data.sellerId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.price is number
        && request.resource.data.price > 0;
      allow update: if signedIn() && resource.data.sellerId == request.auth.uid
        && request.resource.data.sellerId == resource.data.sellerId;
      allow delete: if signedIn() && resource.data.sellerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
      match /favourites/{listingId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
      match /addresses/{addressId} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /chats/{chatId} {
      allow read: if isParticipant(resource.data);
      allow create: if signedIn() && request.auth.uid in request.resource.data.participantIds;
      allow update: if isParticipant(resource.data)
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','updatedAt']);
      allow delete: if false;
      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000;
        allow update, delete: if false;
      }
    }

    match /offers/{offerId} {
      allow read: if isParticipant(resource.data);
      allow create: if signedIn()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.buyerId != request.resource.data.sellerId
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.status == 'pending';
      allow update: if isParticipant(resource.data)
        && resource.data.status == 'pending'
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.buyerId == resource.data.buyerId
        && request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.listingId == resource.data.listingId
        && (
          (request.auth.uid == resource.data.sellerId && request.resource.data.status in ['accepted','declined','countered'])
          || (request.auth.uid == resource.data.buyerId && request.resource.data.status in ['withdrawn','countered'])
        );
      allow delete: if false;
    }

    match /orders/{orderId} {
      allow read: if isParticipant(resource.data);
      allow create: if signedIn()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.buyerId != request.resource.data.sellerId
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.currency == 'gbp'
        && request.resource.data.status == 'awaiting_payment'
        && request.resource.data.paymentStatus == 'not_started'
        && request.resource.data.shippingStatus == 'not_started';
      allow update: if isParticipant(resource.data)
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','problemReportId','updatedAt'])
        && request.resource.data.status == 'problem_reported';
      allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.reviewerId == request.auth.uid
        && request.resource.data.revieweeId != request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
      allow update, delete: if false;
    }

    match /reports/{reportId} {
      allow read: if isParticipant(resource.data);
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.status == 'open';
      allow update, delete: if false;
    }
  }
}